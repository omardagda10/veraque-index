# ==============================================================================
# Google Sheets
# ==============================================================================
SPREADSHEET_ID=1pD4X3k0rldORiLDWUWBFSsKtLoKOACGg4hP8sl6cE-0
SHEET_GID=1037785648
# Opcional: si prefieres buscar la pestaña por nombre en lugar de GID
SHEET_NAME=
# Fila donde están los encabezados (1 = primera fila)
HEADER_ROW=1

# Pestaña para guardar el histórico por fecha (se crea automáticamente si no existe)
ENABLE_HISTORY=true
HISTORY_SHEET_NAME=Historial

# Mapeo opcional de columnas (si se dejan vacíos, se detectan automáticamente por encabezado)
COL_URL=
COL_LAST_CRAWL=
COL_GOOGLE_STATUS=
COL_PROCESS_STATUS=
COL_LAST_CHECK=

# ==============================================================================
# Google Search Console
# ==============================================================================
# Usa "auto" para detectar automáticamente la propiedad en Search Console según cada URL,
# o define una propiedad fija, por ejemplo: sc-domain:tudominio.com o https://tudominio.com/
SEARCH_CONSOLE_SITE_URL=auto
SEARCH_CONSOLE_LANGUAGE_CODE=es-419

# ==============================================================================
# Credenciales de Service Account (elige UNA de las dos opciones)
# Cuenta actual: mantenimientos-newe@mantenimientos-501619.iam.gserviceaccount.com
# ==============================================================================
# Opción 1 (Recomendada en Dokploy): contenido del archivo JSON (plano en una línea o Base64)
GOOGLE_SERVICE_ACCOUNT_JSON=
# Opción 2: ruta a un archivo JSON montado en el contenedor
GOOGLE_SERVICE_ACCOUNT_FILE=

# ==============================================================================
# Automatización y Servidor
# ==============================================================================
# Expresión cron (por defecto: cada 6 horas en el minuto 0)
CRON_SCHEDULE=0 */6 * * *
TIMEZONE=America/Mexico_City
MANUAL_ONLY=false
RUN_ON_STARTUP=false

# Límites de seguridad para cuidar la cuota diaria de Search Console (2,000 req/día/propiedad)
MAX_URLS_PER_RUN=200
REQUEST_DELAY_SECONDS=0.35

# Valores escritos en la columna de estado del proceso
COMPLETED_STATUS_VALUE=Completada
PENDING_STATUS_VALUE=Pendiente
ERROR_STATUS_VALUE=Error

# Seguridad para endpoints protegidos (/run, /sheet/columns)
API_SECRET=cambia-este-token-secreto
PORT=8000
LOG_LEVEL=INFO
